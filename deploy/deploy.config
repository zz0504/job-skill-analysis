# 部署配置文件
# 请根据你的服务器实际情况修改以下配置

# 服务器信息
SERVER_IP="你的服务器IP"
SERVER_USER="root"
PROJECT_DIR="/var/www/job-analysis"

# 数据库配置
MYSQL_ROOT_PASSWORD="你的MySQL root密码"
MYSQL_DATABASE="job_skill_analysis"
MYSQL_USER="jobuser"
MYSQL_PASSWORD="CHANGE_ME_DB_PASSWORD"

# 应用配置
BACKEND_PORT=8000
FRONTEND_PORT=80

# Redis配置（可选）
REDIS_ENABLED=false
REDIS_PASSWORD=""

# 域名配置（如果有）
DOMAIN=""
USE_HTTPS=false
