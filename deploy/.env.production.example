# 生产环境配置
PROJECT_NAME=招聘岗位技能关键词分析系统
API_V1_STR=/api/v1

# MySQL配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=jobuser
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD
MYSQL_DATABASE=job_skill_analysis

# 上传配置
UPLOAD_DIR=/var/www/job-analysis/backend/uploads
MAX_FILE_SIZE=52428800

# Redis配置（可选）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CACHE_TTL=1800
REDIS_ENABLED=false

# 安全配置
SECRET_KEY=CHANGE_ME_RANDOM_SECRET_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS配置
BACKEND_CORS_ORIGINS=["http://localhost","http://localhost:80"]
